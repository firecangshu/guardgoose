stateDiagram-v2
    [*] --> Zone0: 系统启动

    Zone0 --> Zone1: 长时间静止 / 呼吸异常
    Zone0 --> Zone2: 跌倒 + 呼吸正常
    Zone0 --> Zone3: 跌倒 + 呼吸异常
    Zone0 --> Zone4: 呼吸消失

    Zone1 --> Zone0: 30min复查正常 ↓
    Zone1 --> Zone3: 30min复查恶化 ↑

    Zone2 --> Zone3: 语音超时30s ↑
    Zone2 --> Zone3: 呼吸恶化 ↑
    Zone2 --> Zone0: 老人回应我没事 ↓

    Zone3 --> Zone4: 5min无子女确认 ↑
    Zone3 --> Zone4: 高血压10min ↑
    Zone3 --> Zone0: 呼吸恢复+子女确认 ↓

    Zone4 --> Zone3: 呼吸恢复(告警不解除) ↓

    state Zone0 {
        [*] --> 绿区正常
        绿区正常: 有人活动 / 呼吸正常
    }
    state Zone1 {
        [*] --> 黄区关注
        黄区关注: 长时静止 / 呼吸异常
    }
    state Zone2 {
        [*] --> 橙区语音确认
        橙区语音确认: 跌倒+呼吸正常
        橙区语音确认 --> TTS朗读: 触发语音
        TTS朗读 --> 等待回应: 30s倒计时
    }
    state Zone3 {
        [*] --> 红区立即告警
        红区立即告警: 跌倒+呼吸异常
        红区立即告警: 语音超时
        红区立即告警: 复查恶化
    }
    state Zone4 {
        [*] --> 黑区紧急救援
        黑区紧急救援: 呼吸消失
        黑区紧急救援: Zone3超时
    }

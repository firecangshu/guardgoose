graph LR
    subgraph 硬件["📡 硬件层（数据采集端）"]
        ESP["ESP32 接收端<br/>芯片: ESP32-WROOM-32<br/>协议: 802.11n HT20<br/>信道: 36 (5180MHz)<br/>采样率: 100Hz<br/>子载波: 30 个<br/>天线: 3 根<br/>极化: 垂直极化"]
    end

    subgraph 传输["🔒 传输加密"]
        TLS["TLS 1.3 加密<br/>证书: Let's Encrypt<br/>端口: 443/HTTPS<br/>双向认证 mTLS 可选"]
    end

    subgraph 边缘["🖥️ 边缘层（本地处理 · 隐私边界）"]
        INGEST["数据接入<br/>POST /ingest/sample"]
        PROC["信号处理<br/>FFT + 带通滤波<br/>0.15~0.5Hz 呼吸带"]
        DECIDE["状态决策<br/>状态机 + Qwen 推理"]
        STORE[("SQLite 本地存储<br/>events + alerts 表<br/>保留: 90天")]
    end

    subgraph 脱敏["🔐 脱敏边界（关键）"]
        FILTER["数据过滤<br/>原始 CSI 矩阵: 不出本地<br/>仅输出: 语义标签 + Zone级别"]
        SEMANTIC["语义标签集合<br/>{fall_detected, breath_anomaly,<br/>zone_changed, voice_confirmed}<br/>不含: 波形/位置/身份特征"]
    end

    subgraph 云端["☁️ 云端（仅语义）"]
        PUSH["推送通道<br/>WebSocket / MQTT"]
        NOTIFY["子女端通知<br/>仅含: 告警级别 + 时间戳"]
    end

    subgraph 子女["📱 子女端"]
        APP["Web SPA<br/>仅展示语义状态<br/>无法回溯原始信号"]
    end

    ESP -->|"原始 CSI 矩阵<br/>30×3 复数"| TLS
    TLS --> INGEST
    INGEST --> PROC
    PROC --> DECIDE
    DECIDE --> STORE
    DECIDE --> FILTER
    FILTER -->|"仅语义标签"| SEMANTIC
    SEMANTIC --> PUSH
    PUSH --> NOTIFY
    NOTIFY --> APP

    style 硬件 fill:#1a3a2a,stroke:#10b981,color:#e8ecf4
    style 传输 fill:#3a1a1a,stroke:#ef4444,color:#e8ecf4
    style 边缘 fill:#1a2a3a,stroke:#3b82f6,color:#e8ecf4
    style 脱敏 fill:#2a1a3a,stroke:#8b5cf6,color:#e8ecf4
    style 云端 fill:#3a2a1a,stroke:#f59e0b,color:#e8ecf4
    style 子女 fill:#3a2a1a,stroke:#fbbf24,color:#e8ecf4

# ============================================
# 护院鹅 · 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================

# ---- Qwen 认知层（必填） ----
# DashScope API Key，从阿里云模型服务灵积获取
# https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=your_api_key_here

# ---- 服务端口（可选，默认值如下） ----
# SERVER_PORT=8000
# WS_PORT=8000
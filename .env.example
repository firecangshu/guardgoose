# ============================================
# 护院鹅 · 环境变量配置模板
# 复制此文件为 .env 并填入真实值（.env 已 gitignore）
# ============================================

# ---- Qwen 认知层（必填·待创建）----
# DashScope API Key，从阿里云模型服务灵积 / 百炼控制台获取
# https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ---- 魔搭 ModelScope（已有·勿泄露）----
# 用于 ModelScope 数据集下载、模型托管、创空间发布
# https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_TOKEN=your_modelscope_token_here

# ---- 钉钉自定义机器人（必填·待创建）----
# 群机器人 Webhook（含签名密钥）
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_SECRET=SEC...

# ---- 阿里云对象存储 OSS（待开通）----
# 5 分钟视频 / 演示素材托管
# OSS_ACCESS_KEY_ID=your_ak
# OSS_ACCESS_KEY_SECRET=your_aks
# OSS_BUCKET=waveguard-demo
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# ---- 阿里云函数计算 FC（待开通）----
# 边缘服务一键部署（可选）
# FC_REGION=cn-hangzhou
# FC_SERVICE_NAME=waveguard-edge

# ---- 服务端口（可选，默认值如下）----
# SERVER_PORT=8000
# WS_PORT=8000

# ---- 业务参数（可选）----
# 真实用户演示对象（5 分硬门槛）
# PILOT_USER_NAME=王阿姨
# PILOT_USER_CONTACT=13800138000